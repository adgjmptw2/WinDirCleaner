<Window x:Class="WinDirCleaner.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:WinDirCleaner.App.ViewModels"
        mc:Ignorable="d"
        Title="WinDirCleaner"
        MinHeight="600"
        MinWidth="1120"
        Background="#F0F0F0"
        Loaded="MainWindow_OnLoaded">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="DriveCardBorder" TargetType="Border">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Background" Value="#FAFAFA" />
            <Setter Property="BorderBrush" Value="#D8D8D8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style x:Key="PanelCardNeutral" TargetType="Border">
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#F9F9F9" />
            <Setter Property="BorderBrush" Value="#D8D8D8" />
        </Style>
        <Style x:Key="PanelCardInfo" TargetType="Border" BasedOn="{StaticResource PanelCardNeutral}">
            <Setter Property="Background" Value="#F0F7FF" />
            <Setter Property="BorderBrush" Value="#B8D4F0" />
        </Style>
        <Style x:Key="PanelCardExperimental" TargetType="Border" BasedOn="{StaticResource PanelCardNeutral}">
            <Setter Property="Background" Value="#EDE7F6" />
            <Setter Property="BorderBrush" Value="#B39DDB" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#212121" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="SectionHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#555555" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <DataTemplate DataType="{x:Type vm:DriveSummaryViewModel}">
            <Border Style="{StaticResource DriveCardBorder}">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" FontSize="14" Text="{Binding Name}" />
                    <TextBlock Margin="0,2,0,0" Foreground="#555555" Text="{Binding DriveTypeDisplay}" />
                    <TextBlock Margin="0,4,0,0"
                               Foreground="#666666"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Text="{Binding CapacityStatusMessage}" />
                    <TextBlock Margin="0,4,0,0" Foreground="#333333" Text="{Binding Label}" />
                    <StackPanel Margin="0,8,0,0" Visibility="{Binding ShowCapacityProgress, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Foreground="#333333" Text="총 " />
                            <TextBlock Foreground="#333333" Text="{Binding TotalText, Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Foreground="#333333" Text="사용 " />
                            <TextBlock Foreground="#333333" Text="{Binding UsedText, Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Foreground="#333333" Text="여유 " />
                            <TextBlock Foreground="#333333" Text="{Binding FreeText, Mode=OneWay}" />
                        </StackPanel>
                        <TextBlock Margin="0,6,0,4" Foreground="#444444" Text="{Binding UsedPercentText, Mode=OneWay}" />
                        <ProgressBar Height="8"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="{Binding UsedPercent, Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Top" Background="#2D2D30" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="WinDirCleaner"
                               Foreground="#F3F3F3"
                               FontSize="22"
                               FontWeight="SemiBold" />
                    <TextBlock Text="저장소 용량 확인 (읽기 전용)"
                               Foreground="#D0D0D0"
                               Margin="0,4,0,0"
                               FontSize="13" />
                    <TextBlock Text="삭제·정리 실행 없음"
                               Foreground="#B0BEC5"
                               Margin="0,2,0,0"
                               FontSize="11" />
                </StackPanel>
                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            Margin="16,0,0,0">
                    <Border x:Name="DemoModeBadgeBorder"
                            Padding="8,4"
                            Background="#4E342E"
                            CornerRadius="4"
                            Visibility="Collapsed">
                        <TextBlock Foreground="#FFF8E1"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Text="DEMO MODE · 샘플 데이터" />
                    </Border>
                    <CheckBox x:Name="DemoModeCheckBox"
                              Margin="0,8,0,0"
                              Foreground="#E0E0E0"
                              Content="데모 모드"
                              Click="DemoModeCheckBox_OnClick" />
                    <TextBlock x:Name="DemoModeHintText"
                               MaxWidth="280"
                               Margin="0,4,0,0"
                               FontSize="11"
                               Foreground="#B0BEC5"
                               TextWrapping="Wrap"
                               Visibility="Collapsed"
                               Text="스크린샷용 샘플만 표시합니다. 실제 디스크를 읽지 않습니다." />
                </StackPanel>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="#E8E8E8" BorderBrush="#CCCCCC" BorderThickness="0,1,0,0" Padding="12,8">
            <StackPanel>
                <TextBlock x:Name="FooterPhaseText"
                           FontWeight="SemiBold"
                           Text="읽기 전용 — 드라이브 요약" />
                <TextBlock x:Name="FooterDeleteNote" Margin="0,2,0,0" Foreground="#444444" Text="삭제·정리 실행 기능 없음" />
                <TextBlock x:Name="FooterAnalysisStateText" Margin="0,4,0,0" Foreground="#333333" Text="상태: 준비 중" />
                <TextBlock x:Name="LastRefreshText" Margin="0,2,0,0" Foreground="#333333" Text="마지막 드라이브 새로고침: —" />
                <TextBlock x:Name="LastAnalysisTimeText" Margin="0,2,0,0" Foreground="#333333" Text="마지막 상세 분석 완료: —" />
                <TextBlock x:Name="LoadErrorText"
                           Margin="0,4,0,0"
                           Foreground="#8B4513"
                           TextWrapping="Wrap"
                           Visibility="Collapsed" />
            </StackPanel>
        </Border>

        <Grid Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" MinWidth="320" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <!-- Drive list -->
            <Border Grid.Column="0" Background="White" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="4" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock x:Name="DriveLoadStatusText"
                                   TextWrapping="Wrap"
                                   Foreground="#444444"
                                   Visibility="Collapsed" />
                        <ProgressBar x:Name="DriveLoadProgress"
                                     Height="6"
                                     Margin="0,4,0,0"
                                     Visibility="Collapsed"
                                     IsIndeterminate="True" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="0,0,0,6">
                        <TextBlock Style="{StaticResource SectionTitle}" Margin="0" Text="빠른 개요" />
                        <TextBlock Margin="0,2,0,0" Foreground="#555555" FontSize="12" Text="드라이브 목록" />
                    </StackPanel>
                    <TextBlock Grid.Row="2"
                               Style="{StaticResource SectionHint}"
                               Margin="0,0,0,8"
                               Text="이름·유형을 먼저 보여 주고, 용량은 별도로 조회합니다." />
                    <Button Grid.Row="3"
                            x:Name="RefreshDrivesButton"
                            Content="드라이브 새로고침"
                            Padding="10,6"
                            Margin="0,0,0,8"
                            Click="RefreshDrivesButton_OnClick" />
                    <ScrollViewer Grid.Row="4"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Auto">
                        <ListBox x:Name="DriveList"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 SelectionChanged="DriveList_OnSelectionChanged">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#E3F2FD" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </ScrollViewer>
                    <TextBlock Grid.Row="5"
                               TextWrapping="Wrap"
                               FontSize="11"
                               Foreground="#666666"
                               Margin="0,8,0,0"
                               Text="읽기 전용: 목록·집계만 합니다. 파일을 삭제하지 않습니다." />
                </Grid>
            </Border>

            <!-- Analysis results -->
            <Border Grid.Column="2" Background="White" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="4" Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Style="{StaticResource SectionTitle}" Text="상세 분석 (일반)" />
                    <TextBlock Grid.Row="1"
                               Style="{StaticResource SectionHint}"
                               Text="선택한 드라이브 루트의 바로 아래 항목만 표시합니다." />

                    <Border Grid.Row="2" Style="{StaticResource PanelCardNeutral}">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Margin="0,0,0,6" Text="분석 방식" />
                            <TextBlock TextWrapping="Wrap" Foreground="#333333" Margin="0,0,0,6">
                                <Run FontWeight="SemiBold" Text="빠른 개요" />
                                <Run Text=" — 이름·유형·용량만 확인합니다." />
                            </TextBlock>
                            <TextBlock TextWrapping="Wrap" Foreground="#333333">
                                <Run FontWeight="SemiBold" Text="드라이브 상세 분석" />
                                <Run Text=" — 선택한 드라이브 루트의 바로 아래 항목을 집계합니다." />
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Row="3" Margin="0,0,0,6">
                        <TextBlock x:Name="DemoModeAnalysisNoticeText"
                                   Margin="0,0,0,8"
                                   TextWrapping="Wrap"
                                   Foreground="#5D4037"
                                   FontSize="12"
                                   Visibility="Collapsed"
                                   Text="데모: 실제 분석·진단은 실행되지 않습니다. 표·정리 후보·아래 텍스트는 샘플입니다." />
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="StartAnalysisButton"
                                    Content="드라이브 상세 분석"
                                    Padding="10,6"
                                    Margin="0,0,8,0"
                                    Click="StartAnalysisButton_OnClick" />
                            <Button x:Name="CancelAnalysisButton"
                                    Content="상세 분석 취소"
                                    Padding="10,6"
                                    IsEnabled="False"
                                    Click="CancelAnalysisButton_OnClick" />
                        </StackPanel>
                        <TextBlock Margin="0,8,0,4"
                                   TextWrapping="Wrap"
                                   Foreground="#555555"
                                   FontSize="12"
                                   Text="기본은 순차 분석입니다." />
                        <CheckBox x:Name="ExperimentalFastDetailCheckBox"
                                  Margin="0,0,0,4"
                                  Content="실험적 빠른 상세 분석"
                                  Checked="ExperimentalFastDetailCheckBox_OnCheckedChanged"
                                  Unchecked="ExperimentalFastDetailCheckBox_OnCheckedChanged" />
                        <TextBlock TextWrapping="Wrap"
                                   Foreground="#666666"
                                   FontSize="11"
                                   Margin="0,0,0,6"
                                   Text="바로 아래 항목만 제한적으로 병렬 처리합니다." />
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#333333" Text="동시 작업 수" />
                            <ComboBox x:Name="ParallelDegreeComboBox"
                                      Width="72" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Grid.Row="4"
                               TextWrapping="Wrap"
                               Foreground="#444444"
                               FontSize="12"
                               Margin="0,0,0,8"
                               Text="드라이브를 고른 뒤 상세 분석을 시작하세요." />

                    <TextBlock x:Name="AnalysisStateText"
                               Grid.Row="5"
                               TextWrapping="Wrap"
                               Foreground="#444444"
                               Margin="0,0,0,6"
                               Text="빠른 개요를 준비하는 중입니다…" />

                    <Border x:Name="AnalysisProgressPanel"
                            Grid.Row="6"
                            Margin="0,0,0,8"
                            Padding="10,8"
                            Background="#F7F7F7"
                            BorderBrush="#D8D8D8"
                            BorderThickness="1"
                            CornerRadius="4"
                            Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="AnalysisProgressTitleText" FontWeight="SemiBold" Text="상세 분석 진행" />
                            <TextBlock x:Name="AnalysisProgressCurrentText"
                                       Margin="0,4,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="#333333" />
                            <TextBlock x:Name="AnalysisProgressRatioText"
                                       Margin="0,4,0,0"
                                       Foreground="#333333" />
                            <ProgressBar x:Name="AnalysisProgressBar"
                                         Height="10"
                                         Margin="0,6,0,0"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="0" />
                            <TextBlock x:Name="AnalysisProgressPercentText"
                                       Margin="0,4,0,0"
                                       Foreground="#444444" />
                            <TextBlock x:Name="AnalysisProgressScanStatsText"
                                       Margin="0,4,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="#333333" />
                            <TextBlock x:Name="AnalysisProgressElapsedText"
                                       Margin="0,2,0,0"
                                       Foreground="#333333" />
                            <TextBlock Margin="0,6,0,0"
                                       TextWrapping="Wrap"
                                       FontSize="11"
                                       Foreground="#666666"
                                       Text="진행률은 바로 아래 항목 처리 기준입니다." />
                        </StackPanel>
                    </Border>

                    <DataGrid x:Name="AnalysisResultsGrid"
                              Grid.Row="7"
                              MinHeight="220"
                              MaxHeight="520"
                              VerticalScrollBarVisibility="Auto"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserReorderColumns="False"
                              HeadersVisibility="Column"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              GridLinesVisibility="Horizontal"
                              BorderBrush="#D0D0D0"
                              BorderThickness="1"
                              SelectionChanged="AnalysisResultsGrid_OnSelectionChanged" />

                    <Border x:Name="AnalysisPerformancePanel"
                            Grid.Row="8"
                            Style="{StaticResource PanelCardNeutral}"
                            Margin="0,8,0,10"
                            Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="성능 요약" />
                            <TextBlock x:Name="AnalysisPerformanceSummaryBodyText"
                                       Margin="0,4,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="#333333"
                                       FontSize="12" />
                            <TextBlock Margin="0,10,0,4"
                                       FontWeight="SemiBold"
                                       Text="느린 항목 (상위 5)" />
                            <TextBlock Foreground="#555555"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Text="항목별 분석 소요 시간 기준입니다." />
                            <TextBlock x:Name="AnalysisSlowTopItemsText"
                                       Margin="0,4,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="#222222"
                                       FontSize="12" />
                            <TextBlock x:Name="AnalysisPerformanceNoteText"
                                       Margin="0,10,0,0"
                                       TextWrapping="Wrap"
                                       FontSize="11"
                                       Foreground="#666666" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="9"
                            Margin="0,8,0,10"
                            Style="{StaticResource PanelCardNeutral}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Margin="0,0,0,4" Text="정리 후보 미리보기" />
                            <TextBlock Style="{StaticResource SectionHint}"
                                       Margin="0,0,0,6"
                                       Text="권장 / 선택 / 위험으로 분류된 정리 후보를 보여줍니다. 현재는 삭제 기능이 없습니다." />
                            <TextBlock Margin="0,0,0,8"
                                       TextWrapping="Wrap"
                                       Foreground="#6D4C41"
                                       FontSize="11"
                                       Text="〔미리보기〕정적 목록으로 시작합니다. 아래 버튼으로 일부 안전 경로만 읽기 전용 크기 확인을 실행할 수 있습니다." />
                            <TextBlock x:Name="CleanupRefreshHintText"
                                       Margin="0,0,0,6"
                                       TextWrapping="Wrap"
                                       Foreground="#444444"
                                       FontSize="11"
                                       Text="일부 안전 후보의 크기를 읽기 전용으로 확인합니다. 파일을 수정하거나 삭제하지 않습니다." />
                            <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                                <Button x:Name="CleanupRefreshButton"
                                        Padding="10,6"
                                        Content="정리 후보 새로고침"
                                        Click="CleanupRefreshButton_OnClick" />
                            </StackPanel>
                            <TextBlock x:Name="CleanupDetectionStatusText"
                                       Margin="0,0,0,8"
                                       TextWrapping="Wrap"
                                       Foreground="#333333"
                                       FontSize="12"
                                       Text="정적 미리보기를 표시 중입니다." />
                            <DataGrid x:Name="CleanupCandidatesGrid"
                                      MinHeight="160"
                                      MaxHeight="360"
                                      VerticalScrollBarVisibility="Auto"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      CanUserReorderColumns="False"
                                      IsReadOnly="False"
                                      SelectionMode="Single"
                                      SelectionUnit="FullRow"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal"
                                      BorderBrush="#D0D0D0"
                                      BorderThickness="1"
                                      SelectionChanged="CleanupCandidatesGrid_OnSelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="선택" Width="52" IsReadOnly="False">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          IsEnabled="{Binding IsSelectable}"
                                                          IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Width="160"
                                                        Binding="{Binding Name, Mode=OneWay}"
                                                        Header="이름"
                                                        IsReadOnly="True" />
                                    <DataGridTextColumn Width="130"
                                                        Binding="{Binding RiskBadgeText, Mode=OneWay}"
                                                        Header="분류"
                                                        IsReadOnly="True" />
                                    <DataGridTextColumn Width="120"
                                                        Binding="{Binding SizeText, Mode=OneWay}"
                                                        Header="크기"
                                                        IsReadOnly="True" />
                                    <DataGridTextColumn Width="220"
                                                        Binding="{Binding Path, Mode=OneWay}"
                                                        Header="경로"
                                                        IsReadOnly="True" />
                                    <DataGridTextColumn Width="280"
                                                        Binding="{Binding SummaryForGrid, Mode=OneWay}"
                                                        Header="설명 요약"
                                                        IsReadOnly="True" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock x:Name="CleanupSelectionSummaryText"
                                       Margin="0,8,0,0"
                                       FontSize="12"
                                       Foreground="#333333"
                                       TextWrapping="Wrap"
                                       Text="선택 0개 · 합계 크기: —" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="10"
                            Margin="0,8,0,10"
                            Style="{StaticResource PanelCardExperimental}">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Foreground="#4527A0" FontSize="14" Text="실험적 NTFS 진단" />
                            <TextBlock Margin="0,6,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="#5E35B1"
                                       FontSize="12"
                                       Text="NTFS/USN 기반 진단 기능입니다. 현재는 연구용이며 기본 상세 분석을 대체하지 않습니다." />
                            <TextBlock Margin="0,4,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="#6A1B9A"
                                       FontSize="11"
                                       Text="읽기만 합니다. 자세한 범위는 docs/NTFS_FAST_SCAN_RESEARCH.md 를 참고하세요." />

                            <Border Margin="0,12,0,0"
                                    Padding="10,8"
                                    Background="#F3E5F5"
                                    BorderBrush="#CE93D8"
                                    BorderThickness="1"
                                    CornerRadius="4">
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" Foreground="#4527A0" Text="진단 요약" />
                                    <TextBlock x:Name="NtfsDiagnosticSummaryText"
                                               Margin="0,6,0,0"
                                               TextWrapping="Wrap"
                                               Foreground="#4A148C"
                                               FontSize="12"
                                               Text="아직 실험 진단을 실행하지 않았습니다." />
                                </StackPanel>
                            </Border>

                            <TextBlock Margin="0,16,0,4" FontWeight="SemiBold" Foreground="#4527A0" Text="진단 1 · 레코드 열거 속도" />
                            <TextBlock TextWrapping="Wrap" Foreground="#5E35B1" FontSize="11" Margin="0,0,0,8"
                                       Text="볼륨에서 USN/MFT 레코드를 얼마나 빠르게 읽을 수 있는지 확인합니다." />
                            <Button x:Name="NtfsFastScanDiagButton"
                                    HorizontalAlignment="Left"
                                    Padding="10,6"
                                    Content="레코드 열거 진단"
                                    Click="NtfsFastScanDiagButton_OnClick" />
                            <TextBlock x:Name="NtfsFastScanDiagResultText"
                                       Margin="0,10,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="#4527A0"
                                       FontSize="12"
                                       Text="아직 실행하지 않았습니다." />

                            <TextBlock Margin="0,16,0,4" FontWeight="SemiBold" Foreground="#4527A0" Text="진단 2 · 트리 골격" />
                            <TextBlock TextWrapping="Wrap" Foreground="#5E35B1" FontSize="11" Margin="0,0,0,8"
                                       Text="FRN / ParentFRN 관계로 파일·폴더 트리 골격을 만들 수 있는지 확인합니다. 폴더별 용량은 여기서 다루지 않습니다." />
                            <Button x:Name="NtfsFastScanTreeDiagButton"
                                    HorizontalAlignment="Left"
                                    Padding="10,6"
                                    Content="트리 골격 진단"
                                    Click="NtfsFastScanTreeDiagButton_OnClick" />
                            <TextBlock x:Name="NtfsFastScanTreeDiagResultText"
                                       Margin="0,10,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="#4527A0"
                                       FontSize="12"
                                       Text="아직 실행하지 않았습니다." />

                            <TextBlock Margin="0,16,0,4" FontWeight="SemiBold" Foreground="#4527A0" Text="진단 3 · 파일 크기 샘플" />
                            <TextBlock TextWrapping="Wrap" Foreground="#5E35B1" FontSize="11" Margin="0,0,0,8"
                                       Text="OpenFileById로 일부 파일의 크기를 읽을 수 있는지 확인합니다. 전 볼륨 조회는 하지 않습니다." />
                            <StackPanel Margin="0,0,0,0" Orientation="Horizontal">
                                <TextBlock VerticalAlignment="Center" Foreground="#4527A0" Text="샘플 수:" />
                                <ComboBox x:Name="NtfsFileSizeSampleCountComboBox"
                                          Width="100"
                                          Margin="8,0,0,0"
                                          SelectedIndex="1"
                                          SelectionChanged="NtfsFileSizeSampleCountComboBox_OnSelectionChanged">
                                    <ComboBoxItem Content="100" Tag="100" />
                                    <ComboBoxItem Content="500" Tag="500" />
                                    <ComboBoxItem Content="1000" Tag="1000" />
                                    <ComboBoxItem Content="5000" Tag="5000" />
                                    <ComboBoxItem Content="10000" Tag="10000" />
                                    <ComboBoxItem Content="50000" Tag="50000" />
                                </ComboBox>
                            </StackPanel>
                            <TextBlock x:Name="NtfsFileSizeBenchmarkHintText"
                                       Margin="0,4,0,0"
                                       TextWrapping="Wrap"
                                       FontSize="11"
                                       Foreground="#6A1B9A"
                                       Visibility="Collapsed"
                                       Text="5,000 이상은 벤치마크용입니다. 수 초 이상 걸릴 수 있으며, USN 순서상 초반 편향을 줄이기 위해 stride 샘플링을 씁니다(완전 무작위는 아님)." />
                            <Button x:Name="NtfsFileSizeProbeButton"
                                    Margin="0,10,0,0"
                                    HorizontalAlignment="Left"
                                    Padding="10,6"
                                    Content="파일 크기 샘플 진단"
                                    Click="NtfsFileSizeProbeButton_OnClick" />
                            <TextBlock x:Name="NtfsFileSizeProbeResultText"
                                       Margin="0,10,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="#4527A0"
                                       FontSize="12"
                                       Text="아직 실행하지 않았습니다." />
                        </StackPanel>
                    </Border>
                </Grid>
                </ScrollViewer>
            </Border>

            <!-- Selection detail -->
            <Border Grid.Column="4" Background="White" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="4" Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionTitle}" Text="선택 항목" />

                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock x:Name="RightDriveContextText"
                                   TextWrapping="Wrap"
                                   Foreground="#555555"
                                   Margin="0,0,0,8"
                                   Text="읽기 전용으로 드라이브 사용량을 봅니다. 삭제·정리 실행은 없습니다. 공개 캡처는 데모 모드를 권장합니다." />

                        <Separator Margin="0,0,0,8" />

                        <StackPanel x:Name="CleanupCandidateDetailPanel" Visibility="Collapsed" Margin="0,0,0,12">
                            <TextBlock FontWeight="SemiBold" Foreground="#37474F" Text="정리 후보(미리보기)" />
                            <TextBlock x:Name="CleanupDetailNameText" Margin="0,6,0,0" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock x:Name="CleanupDetailRiskText" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="#333333" />
                            <TextBlock x:Name="CleanupDetailPathText" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="#333333" />
                            <TextBlock x:Name="CleanupDetailDescriptionText" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#333333" />
                            <TextBlock x:Name="CleanupDetailReasonText" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#444444" />
                            <TextBlock x:Name="CleanupDetailImpactText" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#444444" />
                            <TextBlock x:Name="CleanupDetailStatusText"
                                       Margin="0,10,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="#5D4037"
                                       FontSize="12"
                                       Text="현재 상태: 미리보기 / 삭제 기능 없음" />
                            <TextBlock x:Name="CleanupDetailDangerNoteText"
                                       Margin="0,6,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="#B71C1C"
                                       FontSize="12"
                                       Visibility="Collapsed"
                                       Text="이 항목은 보호됨 상태이며 선택하거나 삭제할 수 없습니다." />
                        </StackPanel>

                        <StackPanel x:Name="AnalysisEntryDetailPanel" Visibility="Collapsed" Margin="0,0,0,12">
                            <TextBlock x:Name="DetailNameText" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock x:Name="DetailPathText" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="#333333" />
                            <TextBlock x:Name="DetailSizeText" Margin="0,4,0,0" Foreground="#333333" />
                            <TextBlock x:Name="DetailTypeText" Margin="0,4,0,0" Foreground="#333333" />
                            <TextBlock x:Name="DetailCountsText" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="#333333" />
                            <TextBlock x:Name="DetailAnalysisPerfText" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="#444444" />
                            <TextBlock x:Name="DetailNoteText" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="#555555" />
                            <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#333333">
                                정리 추천이 아닙니다. 표시는 집계 결과일 뿐입니다.
                            </TextBlock>
                        </StackPanel>

                        <TextBlock x:Name="PolicyHeadingText" Text="안전·안내" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6" />
                        <ScrollViewer x:Name="PolicyScrollViewer" VerticalScrollBarVisibility="Auto" MaxHeight="480">
                            <StackPanel>
                                <TextBlock TextWrapping="Wrap" Margin="0,0,0,6" Foreground="#333333" FontSize="12">
                                    · 읽기 전용: 파일을 만들거나 지우지 않습니다.
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap" Margin="0,0,0,6" Foreground="#333333" FontSize="12">
                                    · 일반 상세 분석과 실험 NTFS 진단은 역할이 다릅니다. NTFS는 기본 분석을 대체하지 않습니다.
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap" Margin="0,0,0,6" Foreground="#333333" FontSize="12">
                                    · 백그라운드 상주·시작 프로그램 등록 없음.
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap" Foreground="#333333" FontSize="12">
                                    · 자세한 안전 범위: docs/SAFETY_POLICY.md
                                </TextBlock>
                            </StackPanel>
                        </ScrollViewer>
                    </StackPanel>
                </DockPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</Window>
